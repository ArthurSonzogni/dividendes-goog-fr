{
  "manifest_version": 3,
  "name": "Dividendes GOOG – 2778-DIV-SD",
  "version": "0.4.0",
  "description": "French 2778-DIV-SD declaration and tax return boxes for Alphabet (GOOG) dividends from Morgan Stanley at Work.",
  "action": {
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://data-api.ecb.europa.eu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://atwork.morganstanley.com/*"
      ],
      "js": [
        "content/parse.js",
        "content/morgan-stanley-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://atwork.morganstanley.com/*"
      ],
      "js": [
        "content/morgan-stanley.js"
      ]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
